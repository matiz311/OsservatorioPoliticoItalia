{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Italian government",
  "type": "object",
  "required": [
    "id",
    "name",
    "start_date",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "legislature": {
      "type": [
        "string",
        "null"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "prime_minister": {
      "type": "string"
    },
    "cabinet_parties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "external_support_parties": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contexts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
