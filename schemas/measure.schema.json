{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/measure.schema.json",
  "title": "Policy measure",
  "type": "object",
  "required": [
    "id",
    "title",
    "government_id",
    "status",
    "sources"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_\\-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "policy_area": {
      "type": "string"
    },
    "government_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "announced",
        "proposed",
        "parliamentary_process",
        "approved",
        "partially_implemented",
        "implemented",
        "repealed",
        "expired",
        "blocked"
      ]
    },
    "actors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "actor_id",
          "role",
          "evidence_basis"
        ],
        "properties": {
          "actor_id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "evidence_basis": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "legal_basis": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "act_type": {
            "type": "string"
          },
          "number": {
            "type": [
              "string",
              "integer"
            ]
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "additionalProperties": false
      }
    },
    "implementation": {
      "type": "object",
      "properties": {
        "required_secondary_acts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "adopted_secondary_acts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "indicator",
          "evaluation_design",
          "source_ids"
        ],
        "properties": {
          "indicator": {
            "type": "string"
          },
          "population": {
            "type": [
              "string",
              "null"
            ]
          },
          "baseline_period": {
            "type": [
              "string",
              "null"
            ]
          },
          "observed_period": {
            "type": [
              "string",
              "null"
            ]
          },
          "baseline_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "observed_value": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          },
          "explicit_target": {
            "type": [
              "number",
              "string",
              "null"
            ]
          },
          "evaluation_design": {
            "type": "string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "external_factors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "distributional_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unintended_effects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
